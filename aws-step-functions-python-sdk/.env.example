# ── Wherobots ────────────────────────────────────────────────────────────────
# Create an API key at https://cloud.wherobots.com (Settings → API Keys)
WHEROBOTS_API_KEY=
WHEROBOTS_REGION=aws-us-west-2

# Optional: name of a Wherobots Storage Integration to upload the job script
# to. Leave blank to use Wherobots managed storage (the default).
STORAGE_INTEGRATION=

# Wherobots runtime size for the job run (tiny is the cheapest)
JOB_RUNTIME=tiny

# ── AWS ──────────────────────────────────────────────────────────────────────
# Leave all of these blank to use your default AWS credential chain
# (default profile, SSO session, or instance role). Set them only if you
# want this project pinned to specific credentials.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_PROFILE=
AWS_REGION=us-west-2

# ── Naming ───────────────────────────────────────────────────────────────────
# Prefix for every AWS resource this reference creates (roles, lambdas,
# state machines). Teardown deletes only resources with this prefix.
RESOURCE_PREFIX=wherobots-sfn-ref
